// ════════════════════════════════════════════════════════════════════════════
// SECTION 2: CORE STATE ARRAYS
// ════════════════════════════════════════════════════════════════════════════

// Visual elements
var box[] zBox = array.new<box>()
var label[] zTag = array.new<label>()
var label[] zRetest = array.new<label>()
var label[] zEntry2Tag = array.new<label>()
var line[] zTp1Line = array.new<line>()
var line[] zTp2Line = array.new<line>()
var line[] zSlLine = array.new<line>()

// Zone geometry
var float[] zTop = array.new<float>()
var float[] zBot = array.new<float>()
var float[] zEntryPrice = array.new<float>()   // Entry 1: nearest zone edge
var float[] zEntry2Price = array.new<float>()  // Entry 2: far zone edge
var float[] zStopPrice = array.new<float>()
var float[] zTarget1Price = array.new<float>()  // TP1 = +1R
var float[] zTarget2Price = array.new<float>()  // TP2 = +2R

// Zone state flags
var bool[] zDemand = array.new<bool>()
var bool[] zBroken = array.new<bool>()
var bool[] zArmed = array.new<bool>()
var bool[] zActivated = array.new<bool>()       // Entry 1 activated
var bool[] zEntry2Activated = array.new<bool>()
var bool[] zTp1Hit = array.new<bool>()
var int[] zTp1HitBar = array.new<int>()
var bool[] zTerminal = array.new<bool>()

// Zone timeline tracking
var int[] zSourceBar = array.new<int>()
var int[] zCreatedBar = array.new<int>()
var int[] zArmedBar = array.new<int>()
var int[] zLastRetestBar = array.new<int>()
var int[] zTouches = array.new<int>()
var int[] zActivationBar = array.new<int>()     // Entry 1 activation bar
var int[] zEntry2ActivationBar = array.new<int>()

// Zone identification
var string[] zId = array.new<string>()

// Pending candidates (during confirmation delay)
var bool[] pDemand = array.new<bool>()
var float[] pTop = array.new<float>()
var float[] pBot = array.new<float>()
var int[] pSourceBar = array.new<int>()
var int[] pDueBar = array.new<int>()
var string[] pId = array.new<string>()

// Global state
var int lastDemandCandidateBar = na
var int lastSupplyCandidateBar = na
var int dailySignalSequence = 0
var bool autoWebhookTestSent = false


// ════════════════════════════════════════════════════════════════════════════
// SECTION 3: COMPUTED VALUES & CONSTANTS
// ════════════════════════════════════════════════════════════════════════════

float atr = ta.atr(i_atrLen)
float avgBody = ta.sma(math.abs(close - open), i_bodyLen)
float labelOffset = atr * 0.10
string tfText = timeframe.isminutes ? str.tostring(timeframe.multiplier) + " Min" : timeframe.period

const float MIN_DEPARTURE_PERCENT = 0.15
const float TP1_R = 1.0
const float TP2_R = 2.0
const int SL_SWING_PIVOT_LEN = 2
const int MAX_AFTER_ZONE_SWING_BARS = 60

float pivotHighValue = ta.pivothigh(high, SL_SWING_PIVOT_LEN, SL_SWING_PIVOT_LEN)
float pivotLowValue = ta.pivotlow(low, SL_SWING_PIVOT_LEN, SL_SWING_PIVOT_LEN)

var int[] swingHighBars = array.new<int>()
var float[] swingHighValues = array.new<float>()
var int[] swingLowBars = array.new<int>()
var float[] swingLowValues = array.new<float>()

if not na(pivotHighValue)
    array.push(swingHighBars, bar_index - SL_SWING_PIVOT_LEN)
    array.push(swingHighValues, pivotHighValue)
    if array.size(swingHighBars) > 300
        array.shift(swingHighBars)
        array.shift(swingHighValues)

if not na(pivotLowValue)
    array.push(swingLowBars, bar_index - SL_SWING_PIVOT_LEN)
    array.push(swingLowValues, pivotLowValue)
    if array.size(swingLowBars) > 300
        array.shift(swingLowBars)
        array.shift(swingLowValues)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 4: UTILITY FUNCTIONS
// ════════════════════════════════════════════════════════════════════════════

// Pad integers to 2-digit strings (e.g., 5 → "05")
f_pad2(int value) =>
    value < 10 ? "0" + str.tostring(value) : str.tostring(value)

// Detect instrument from ticker
f_displaySymbol() =>
    string ticker = str.upper(syminfo.ticker)
    str.contains(ticker, "XAU") or str.contains(ticker, "GOLD") ? "XAUUSD" :
     str.contains(ticker, "US30") or str.contains(ticker, "DJI") ? "US30" :
     str.contains(ticker, "NAS") or str.contains(ticker, "USTEC") or str.contains(ticker, "US100") ? "NAS100" :
     str.contains(ticker, "WTI") or str.contains(ticker, "USOIL") ? "WTIUSD" : ticker

f_idSymbol() =>
    string ticker = str.upper(syminfo.ticker)
    str.contains(ticker, "XAU") or str.contains(ticker, "GOLD") ? "XAU" :
     str.contains(ticker, "US30") or str.contains(ticker, "DJI") ? "US30" :
     str.contains(ticker, "NAS") or str.contains(ticker, "USTEC") or str.contains(ticker, "US100") ? "NAS" :
     str.contains(ticker, "WTI") or str.contains(ticker, "USOIL") ? "WTI" : ticker

f_tfCode() =>
    timeframe.isminutes ? str.tostring(timeframe.multiplier) + "M" : timeframe.period

f_signalDate() =>
    f_pad2(month(time)) + f_pad2(dayofmonth(time))

f_makeZoneId(bool demandSide, int sequenceNumber) =>
    f_idSymbol() + "-" + f_tfCode() + "-" + (demandSide ? "B" : "S") + "-" + 
     f_signalDate() + "-LEB" + f_pad2(sequenceNumber)

f_price(float value) =>
    str.tostring(value, format.mintick)

f_sideLimit(bool demandSide) =>
    demandSide ? "BUY LIMIT" : "SELL LIMIT"

f_sideTrade(bool demandSide) =>
    demandSide ? "BUY" : "SELL"

f_entry(bool demandSide, float top, float bot) =>
    demandSide ? top : bot


f_entry2(bool demandSide, float top, float bot) =>
    demandSide ? bot : top

// Custom symbol buffer lookup.
// Custom rules override all built-in defaults.
f_customBuffer(string ticker) =>
    float custom = na

    string s1 = str.upper(i_customSymbol1)
    string s2 = str.upper(i_customSymbol2)
    string s3 = str.upper(i_customSymbol3)
    string s4 = str.upper(i_customSymbol4)
    string s5 = str.upper(i_customSymbol5)
    string s6 = str.upper(i_customSymbol6)

    if str.length(s1) > 0 and (ticker == s1 or str.contains(ticker, s1))
        custom := i_customBuffer1
    else if str.length(s2) > 0 and (ticker == s2 or str.contains(ticker, s2))
        custom := i_customBuffer2
    else if str.length(s3) > 0 and (ticker == s3 or str.contains(ticker, s3))
        custom := i_customBuffer3
    else if str.length(s4) > 0 and (ticker == s4 or str.contains(ticker, s4))
        custom := i_customBuffer4
    else if str.length(s5) > 0 and (ticker == s5 or str.contains(ticker, s5))
        custom := i_customBuffer5
    else if str.length(s6) > 0 and (ticker == s6 or str.contains(ticker, s6))
        custom := i_customBuffer6

    custom

// Dynamic SL buffer based on instrument.
// Priority: custom override -> built-in -> forex default -> fallback.
f_buffer() =>
    string ticker = str.upper(syminfo.ticker)
    float custom = f_customBuffer(ticker)
    bool forexSymbol = syminfo.type == "forex"
    bool jpyPair = forexSymbol and str.contains(ticker, "JPY")

    not na(custom) ? custom :
     str.contains(ticker, "XAU") or str.contains(ticker, "GOLD") ? i_goldBuffer :
     str.contains(ticker, "XAG") or str.contains(ticker, "SILVER") ? i_silverBuffer :
     str.contains(ticker, "US30") or str.contains(ticker, "DJI") ? i_us30Buffer :
     str.contains(ticker, "NAS") or str.contains(ticker, "USTEC") or str.contains(ticker, "US100") ? i_nasBuffer :
     str.contains(ticker, "WTI") or str.contains(ticker, "USOIL") ? i_wtiBuffer :
     forexSymbol ? (jpyPair ? i_forexJpyBuffer : i_forexBuffer) :
     i_fallbackBuffer

f_firstSwingHighAfterZone(int sourceBar, float fallbackValue) =>
    float result = fallbackValue
    if array.size(swingHighBars) > 0
        for x = 0 to array.size(swingHighBars) - 1
            int swingBar = array.get(swingHighBars, x)
            float swingValue = array.get(swingHighValues, x)
            if swingBar > sourceBar and swingBar - sourceBar <= MAX_AFTER_ZONE_SWING_BARS
                result := swingValue
                break
    result

f_firstSwingLowAfterZone(int sourceBar, float fallbackValue) =>
    float result = fallbackValue
    if array.size(swingLowBars) > 0
        for x = 0 to array.size(swingLowBars) - 1
            int swingBar = array.get(swingLowBars, x)
            float swingValue = array.get(swingLowValues, x)
            if swingBar > sourceBar and swingBar - sourceBar <= MAX_AFTER_ZONE_SWING_BARS
                result := swingValue
                break
    result

f_structuralStop(bool demandSide, float top, float bot, int sourceBar) =>
    float stop = na
    if demandSide
        float swingLow = f_firstSwingLowAfterZone(sourceBar, bot)
        stop := math.min(swingLow, bot) - f_buffer()
    else
        float swingHigh = f_firstSwingHighAfterZone(sourceBar, top)
        stop := math.max(swingHigh, top) + f_buffer()
    stop

// Find zone by ID (returns array index)
f_findZoneIndex(string targetId) =>
    int foundIndex = na
    int totalZones = array.size(zId)
    if totalZones > 0
        for k = 0 to totalZones - 1
            if array.get(zId, k) == targetId
                foundIndex := k
                break
    foundIndex

// Count live (non-terminal) zones on one side
f_countSide(bool demandSide) =>
    int count = 0
    int totalZones = array.size(zDemand)
    if totalZones > 0
        for k = 0 to totalZones - 1
            if array.get(zDemand, k) == demandSide
                if not array.get(zTerminal, k)  // Only count non-terminal
                    count += 1
    count

// ════════════════════════════════════════════════════════════════════════════
// SECTION 5: ZONE DELETION & CLEANUP
// ════════════════════════════════════════════════════════════════════════════

// Safely delete zone at index (CRITICAL for memory management)
f_deleteAt(int idx) =>
    if idx >= 0 and idx < array.size(zBox)
        box bx = array.get(zBox, idx)
        if not na(bx)
            box.delete(bx)

        label infoLabel = array.get(zTag, idx)
        if not na(infoLabel)
            label.delete(infoLabel)

        label activationLabel = array.get(zRetest, idx)
        if not na(activationLabel)
            label.delete(activationLabel)

        label entry2Label = array.get(zEntry2Tag, idx)
        if not na(entry2Label)
            label.delete(entry2Label)

        line tp1ZoneLine = array.get(zTp1Line, idx)
        if not na(tp1ZoneLine)
            line.delete(tp1ZoneLine)

        line tp2ZoneLine = array.get(zTp2Line, idx)
        if not na(tp2ZoneLine)
            line.delete(tp2ZoneLine)

        line slZoneLine = array.get(zSlLine, idx)
        if not na(slZoneLine)
            line.delete(slZoneLine)

        array.remove(zBox, idx)
        array.remove(zTag, idx)
        array.remove(zRetest, idx)
        array.remove(zEntry2Tag, idx)
        array.remove(zTp1Line, idx)
        array.remove(zTp2Line, idx)
        array.remove(zSlLine, idx)
        array.remove(zTop, idx)
        array.remove(zBot, idx)
        array.remove(zEntryPrice, idx)
        array.remove(zEntry2Price, idx)
        array.remove(zStopPrice, idx)
        array.remove(zTarget1Price, idx)
        array.remove(zTarget2Price, idx)
        array.remove(zDemand, idx)
        array.remove(zBroken, idx)
        array.remove(zArmed, idx)
        array.remove(zActivated, idx)
        array.remove(zEntry2Activated, idx)
        array.remove(zTp1Hit, idx)
        array.remove(zTp1HitBar, idx)
        array.remove(zTerminal, idx)
        array.remove(zSourceBar, idx)
        array.remove(zCreatedBar, idx)
        array.remove(zArmedBar, idx)
        array.remove(zLastRetestBar, idx)
        array.remove(zTouches, idx)
        array.remove(zActivationBar, idx)
        array.remove(zEntry2ActivationBar, idx)
        array.remove(zId, idx)

// Remove oldest terminal zone to stay under limit
f_trimOldestTerminal(bool demandSide) =>
    int oldestIndex = na
    int oldestSourceBar = 1000000000
    int totalZones = array.size(zDemand)
    if totalZones > 0
        for k = 0 to totalZones - 1
            bool removable = array.get(zDemand, k) == demandSide and array.get(zTerminal, k)
            if removable
                int sourceBar = array.get(zSourceBar, k)
                if sourceBar < oldestSourceBar
                    oldestSourceBar := sourceBar
                    oldestIndex := k
    
    if not na(oldestIndex)
        f_deleteAt(oldestIndex)

// Count terminal zones on one side
f_countTerminalSide(bool demandSide) =>
    int count = 0
    int totalZones = array.size(zDemand)
    if totalZones > 0
        for k = 0 to totalZones - 1
            if array.get(zDemand, k) == demandSide and array.get(zTerminal, k)
                count += 1
    count

// Retain only the newest terminal zones. Never delete a live zone here.
f_trimHistoricToLimit(bool demandSide) =>
    int terminalCount = f_countTerminalSide(demandSide)
    int excess = math.max(0, terminalCount - i_maxHistoricZones)
    if excess > 0
        for n = 1 to excess
            f_trimOldestTerminal(demandSide)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 6: ZONE STYLING & DISPLAY
// ════════════════════════════════════════════════════════════════════════════

f_zoneText() =>
    i_showTF ? tfText + " B9" : "B9"

// Mark zone as historic (after invalidation)
f_setHistoric(int idx) =>
    if idx >= 0 and idx < array.size(zBox)
        box bx = array.get(zBox, idx)
        bool demandSide = array.get(zDemand, idx)
        box.set_bgcolor(bx, demandSide ? i_demandColor : i_supplyColor)
        box.set_border_color(bx, demandSide ? color.new(#2962FF, 25) : color.new(#FB8C00, 25))

// Calculate fixed signal levels.
// R is always measured from Entry 1 to the structural SL.
f_setZoneTradeLevels(int idx) =>
    if idx >= 0 and idx < array.size(zDemand)
        bool demandSide = array.get(zDemand, idx)
        float top = array.get(zTop, idx)
        float bot = array.get(zBot, idx)
        int sourceBar = array.get(zSourceBar, idx)

        float entry1 = f_entry(demandSide, top, bot)
        float entry2 = f_entry2(demandSide, top, bot)
        float stop = f_structuralStop(demandSide, top, bot, sourceBar)
        float risk = math.abs(entry1 - stop)
        float tp1 = demandSide ? entry1 + risk * TP1_R : entry1 - risk * TP1_R
        float tp2 = demandSide ? entry1 + risk * TP2_R : entry1 - risk * TP2_R

        array.set(zEntryPrice, idx, entry1)
        array.set(zEntry2Price, idx, entry2)
        array.set(zStopPrice, idx, stop)
        array.set(zTarget1Price, idx, tp1)
        array.set(zTarget2Price, idx, tp2)

        line tp1ZoneLine = array.get(zTp1Line, idx)
        line tp2ZoneLine = array.get(zTp2Line, idx)
        line slZoneLine = array.get(zSlLine, idx)

        if not na(tp1ZoneLine)
            line.set_y1(tp1ZoneLine, tp1)
            line.set_y2(tp1ZoneLine, tp1)
        if not na(tp2ZoneLine)
            line.set_y1(tp2ZoneLine, tp2)
            line.set_y2(tp2ZoneLine, tp2)
        if not na(slZoneLine)
            line.set_y1(slZoneLine, stop)
            line.set_y2(slZoneLine, stop)

// Update live zone labels.
// Keep the chart compact: one standardized information label per live signal.
f_updateZoneLabels(int idx) =>
    if idx >= 0 and idx < array.size(zDemand)
        bool demandSide = array.get(zDemand, idx)
        bool armed = array.get(zArmed, idx)
        bool tp1Done = array.get(zTp1Hit, idx)

        float entry1 = array.get(zEntryPrice, idx)
        float entry2 = array.get(zEntry2Price, idx)
        float stop = array.get(zStopPrice, idx)
        float tp1 = array.get(zTarget1Price, idx)
        float tp2 = array.get(zTarget2Price, idx)
        float zoneMid = (array.get(zTop, idx) + array.get(zBot, idx)) / 2.0

        box zoneBox = array.get(zBox, idx)
        int rightEdge = not na(zoneBox) ? box.get_right(zoneBox) : bar_index
        int infoX = rightEdge + 1

        label infoLabel = array.get(zTag, idx)
        line tp1ZoneLine = array.get(zTp1Line, idx)
        line tp2ZoneLine = array.get(zTp2Line, idx)
        line slZoneLine = array.get(zSlLine, idx)

        if armed and not tp1Done
            string sideText = demandSide ? "BUY LIMIT" : "SELL LIMIT"
            string infoText =
                 "Entries: " + f_price(entry1) + " - " + f_price(entry2) +
                 "\nSL: " + f_price(stop) +
                 "\nTP1/2: " + f_price(tp1) + " - " + f_price(tp2)

            if not na(zoneBox)
                box.set_text(zoneBox, sideText)
                box.set_text_color(zoneBox, color.white)
                box.set_text_halign(zoneBox, text.align_center)
                box.set_text_valign(zoneBox, text.align_center)
                box.set_text_size(zoneBox, size.small)

            if not na(infoLabel)
                label.set_x(infoLabel, infoX)
                label.set_y(infoLabel, zoneMid)
                label.set_style(infoLabel, label.style_label_left)
                label.set_color(infoLabel, color.new(#263238, 10))
                label.set_textcolor(infoLabel, color.white)
                label.set_text(infoLabel, infoText)

            if not na(tp1ZoneLine)
                line.set_x2(tp1ZoneLine, rightEdge)
            if not na(tp2ZoneLine)
                line.set_x2(tp2ZoneLine, rightEdge)
            if not na(slZoneLine)
                line.set_x2(slZoneLine, rightEdge)

        else if not armed
            if not na(zoneBox)
                box.set_text(zoneBox, f_zoneText())
                box.set_text_color(zoneBox, color.new(color.white, 35))
                box.set_text_halign(zoneBox, text.align_right)
                box.set_text_valign(zoneBox, text.align_center)
                box.set_text_size(zoneBox, size.tiny)

            if not na(infoLabel)
                label.set_style(infoLabel, label.style_none)
                label.set_color(infoLabel, color.new(color.white, 100))
                label.set_textcolor(infoLabel, color.new(color.white, 100))
                label.set_text(infoLabel, "")

            if not na(tp1ZoneLine)
                line.set_color(tp1ZoneLine, color.new(color.green, 100))
            if not na(tp2ZoneLine)
                line.set_color(tp2ZoneLine, color.new(color.green, 100))
            if not na(slZoneLine)
                line.set_color(slZoneLine, color.new(color.red, 100))

f_showTradeLevelLines(int idx) =>
    if idx >= 0 and idx < array.size(zTp1Line)
        line tp1ZoneLine = array.get(zTp1Line, idx)
        line tp2ZoneLine = array.get(zTp2Line, idx)
        line slZoneLine = array.get(zSlLine, idx)
        int transparency = i_showTPSL ? 0 : 100

        if not na(tp1ZoneLine)
            line.set_color(tp1ZoneLine, color.new(#43A047, transparency))
            line.set_width(tp1ZoneLine, 1)

        if not na(tp2ZoneLine)
            line.set_color(tp2ZoneLine, color.new(#00C853, transparency))
            line.set_width(tp2ZoneLine, 2)

        if not na(slZoneLine)
            line.set_color(slZoneLine, color.new(#E53935, transparency))
            line.set_width(slZoneLine, 1)

f_clearSignalLabels(int idx) =>
    if idx >= 0 and idx < array.size(zTag)
        label infoLabel = array.get(zTag, idx)
        if not na(infoLabel)
            label.delete(infoLabel)
            array.set(zTag, idx, label(na))

        label entry1Label = array.get(zRetest, idx)
        if not na(entry1Label)
            label.delete(entry1Label)
            array.set(zRetest, idx, label(na))

        label entry2Label = array.get(zEntry2Tag, idx)
        if not na(entry2Label)
            label.delete(entry2Label)
            array.set(zEntry2Tag, idx, label(na))

f_markTp1Visual(int idx) =>
    if idx >= 0 and idx < array.size(zTp1Line)
        line tp1ZoneLine = array.get(zTp1Line, idx)
        line tp2ZoneLine = array.get(zTp2Line, idx)
        line slZoneLine = array.get(zSlLine, idx)
        box zoneBox = array.get(zBox, idx)

        f_clearSignalLabels(idx)

        if not na(tp1ZoneLine)
            line.set_color(tp1ZoneLine, color.new(#43A047, 100))
        if not na(tp2ZoneLine)
            line.set_color(tp2ZoneLine, color.new(#00C853, 25))
        if not na(slZoneLine)
            line.set_color(slZoneLine, color.new(#E53935, 100))

        if not na(zoneBox)
            box.set_right(zoneBox, bar_index)
            box.set_bgcolor(zoneBox, color.new(#66BB6A, 74))
            box.set_border_color(zoneBox, color.new(#43A047, 8))
            box.set_text(zoneBox, "TP1 HIT")
            box.set_text_color(zoneBox, color.white)
            box.set_text_halign(zoneBox, text.align_center)
            box.set_text_valign(zoneBox, text.align_center)
            box.set_text_size(zoneBox, size.tiny)

f_hideTradeLevelTags(int idx) =>
    if idx >= 0 and idx < array.size(zTag)
        f_clearSignalLabels(idx)

        line tp1ZoneLine = array.get(zTp1Line, idx)
        line tp2ZoneLine = array.get(zTp2Line, idx)
        line slZoneLine = array.get(zSlLine, idx)

        if not na(tp1ZoneLine)
            line.set_color(tp1ZoneLine, color.new(color.green, 100))
        if not na(tp2ZoneLine)
            line.set_color(tp2ZoneLine, color.new(color.green, 100))
        if not na(slZoneLine)
            line.set_color(slZoneLine, color.new(color.red, 100))

f_setTerminalStyle(int idx, string result) =>
    if idx >= 0 and idx < array.size(zBox)
        box zoneBox = array.get(zBox, idx)

        f_clearSignalLabels(idx)

        if not na(zoneBox)
            box.set_right(zoneBox, bar_index)

            if result == "TP2"
                box.set_bgcolor(zoneBox, color.new(#00A63C, 66))
                box.set_border_color(zoneBox, color.new(#00C853, 0))
                box.set_text(zoneBox, "TP2 HIT")
            else if result == "TP1"
                box.set_bgcolor(zoneBox, color.new(#66BB6A, 74))
                box.set_border_color(zoneBox, color.new(#43A047, 8))
                box.set_text(zoneBox, "TP1 FINAL")
            else if result == "SL"
                box.set_bgcolor(zoneBox, color.new(#B71C1C, 76))
                box.set_border_color(zoneBox, color.new(#E53935, 5))
                box.set_text(zoneBox, "SL HIT")
            else
                box.set_text(zoneBox, f_zoneText())

            box.set_text_color(zoneBox, color.white)
            box.set_text_halign(zoneBox, text.align_center)
            box.set_text_valign(zoneBox, text.align_center)
            box.set_text_size(zoneBox, size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 7: COMPACT BASE DETECTION & REFINEMENT
// ════════════════════════════════════════════════════════════════════════════

// Offset helpers
f_preStart() =>
    i_momentumCount

f_preEnd() =>
    i_momentumCount + i_compactSearchBars - 1

f_immediateEnd() =>
    math.min(f_preEnd(), i_momentumCount + i_immediateBaseBars - 1)

// Range finders
f_rangeHigh(int startOff, int endOff) =>
    float best = high[startOff]
    if endOff >= startOff
        for offset = startOff to endOff
            best := math.max(best, high[offset])
    best

f_rangeLow(int startOff, int endOff) =>
    float best = low[startOff]
    if endOff >= startOff
        for offset = startOff to endOff
            best := math.min(best, low[offset])
    best

// Check if candle is compressed
f_isCompression(int offset) =>
    float candleBody = math.abs(close[offset] - open[offset])
    float candleRange = high[offset] - low[offset]
    candleBody <= avgBody * i_compressionBodyMult or candleRange <= atr * i_compactRangeAtr

// Find where the contiguous compact base ends
f_compactBaseEnd() =>
    int startOff = f_preStart()
    int endOff = f_preEnd()
    int compactEnd = startOff
    int compactCount = 0
    bool stillInsideBase = true

    for offset = startOff to endOff
        if stillInsideBase
            if f_isCompression(offset)
                compactEnd := offset
                compactCount += 1
            else
                stillInsideBase := false

    compactCount >= i_compactBaseMinBars ? compactEnd : f_immediateEnd()

// ────────────────────────────────────────────────────────────────────────────
// REFINED ZONE BOUNDARY DETECTION (NEW)
// ────────────────────────────────────────────────────────────────────────────

// Find last opposing candle (Order Block style)
f_findLastOpposing(bool demandSide, int startOff, int endOff) =>
    int bestOff = startOff
    for offset = startOff to endOff
        bool isOpposing = demandSide ? (close[offset] < open[offset]) : (close[offset] > open[offset])
        if isOpposing
            bestOff := offset
            break
    bestOff

// Find candle with smallest range (maximum compression)
f_findSmallestRange(int startOff, int endOff) =>
    int bestOff = startOff
    float minRange = high[startOff] - low[startOff]
    for offset = startOff to endOff
        float rng = high[offset] - low[offset]
        if rng < minRange
            minRange := rng
            bestOff := offset
    bestOff

// Main boundary calculation with refinement option
f_boundary9Bounds(bool demandSide) =>
    int startOff = f_preStart()
    int compactEnd = f_compactBaseEnd()
    float top = na
    float bot = na

    if not i_useRefinement or i_zoneRefinement == "Full Base (Boundary 9)"
        // Legacy: full base high/low
        top := f_rangeHigh(startOff, compactEnd)
        bot := f_rangeLow(startOff, compactEnd)

    else if i_zoneRefinement == "Last Opposing Candle"
        // Order Block: last candle before impulse
        int targetOff = f_findLastOpposing(demandSide, startOff, compactEnd)
        top := high[targetOff]
        bot := low[targetOff]

    else if i_zoneRefinement == "Smallest Range Candle"
        // Compression: tightest candle
        int targetOff = f_findSmallestRange(startOff, compactEnd)
        top := high[targetOff]
        bot := low[targetOff]

    else if i_zoneRefinement == "Extreme Wick + Tight Body"
        // SMC Hybrid: tight body + extreme rejection wick
        int smallOff = f_findSmallestRange(startOff, compactEnd)
        if demandSide
            top := math.max(open[smallOff], close[smallOff])  // Body top
            bot := f_rangeLow(startOff, compactEnd)           // Absolute low
        else
            top := f_rangeHigh(startOff, compactEnd)          // Absolute high
            bot := math.min(open[smallOff], close[smallOff])  // Body bottom

    [top, bot, compactEnd]

// ════════════════════════════════════════════════════════════════════════════
// SECTION 8: ZONE VALIDATION & OVERLAP DETECTION (NEW)
// ════════════════════════════════════════════════════════════════════════════

// Wide zones are shrunk symmetrically instead of rejected.
// Too-narrow zones are still rejected.
f_clampZoneBounds(float top, float bot) =>
    float adjustedTop = top
    float adjustedBot = bot
    float zoneWidth = adjustedTop - adjustedBot
    float maxWidth = atr * i_maxZoneWidthATR

    if zoneWidth > maxWidth
        float excess = zoneWidth - maxWidth
        adjustedTop -= excess / 2.0
        adjustedBot += excess / 2.0

    [adjustedTop, adjustedBot]

f_isValidWidth(float zoneWidth) =>
    zoneWidth >= (atr * i_minZoneWidthATR)

// Geometric overlap detection
f_hasOverlap(bool demandSide, float newTop, float newBot) =>
    bool overlapFound = false
    if not i_allowOverlap
        int totalZones = array.size(zDemand)
        if totalZones > 0
            for k = 0 to totalZones - 1
                bool isSameSide = array.get(zDemand, k) == demandSide
                bool isBroken = array.get(zBroken, k)
                bool isTerminal = array.get(zTerminal, k)
                
                // Only check against active zones on same side
                if isSameSide and not isBroken and not isTerminal
                    float existTop = array.get(zTop, k)
                    float existBot = array.get(zBot, k)
                    
                    // Geometric intersection check with tolerance
                    if newTop >= (existBot - i_overlapTolerance) and newBot <= (existTop + i_overlapTolerance)
                        overlapFound := true
                        break
    overlapFound

// ════════════════════════════════════════════════════════════════════════════
// SECTION 9: PROFESSIONAL ALERT & MESSAGE FUNCTIONS
// ════════════════════════════════════════════════════════════════════════════

const string ALERT_CONTRACT = "LEBPRIME_V3_3"

f_eventTimeUtc() =>
    str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss", "UTC") + "Z"

f_eventHeader(string eventName, string statusName, string signalId) =>
    "Event: " + eventName +
     "\nStatus: " + statusName +
     "\nContract: " + ALERT_CONTRACT +
     "\nID: " + signalId +
     "\nEvent Time: " + f_eventTimeUtc()

f_signalDetails(int idx, string eventName) =>
    bool demandSide = array.get(zDemand, idx)
    string tp1Mark = eventName == "TP1" or eventName == "TP2" ? " ✅" : ""
    string tp2Mark = eventName == "TP2" ? " ✅" : ""
    string slRule = demandSide ? "body close under" : "body close over"

    "\n\nSymbol: " + f_displaySymbol() +
     "\nTimeframe: " + tfText +
     "\n\nEntry 1: " + f_price(array.get(zEntryPrice, idx)) +
     "\nEntry 2: " + f_price(array.get(zEntry2Price, idx)) +
     "\nSL: " + f_price(array.get(zStopPrice, idx)) + " (" + slRule + ")" +
     "\nTP1: " + f_price(array.get(zTarget1Price, idx)) + tp1Mark +
     "\nTP2: " + f_price(array.get(zTarget2Price, idx)) + tp2Mark

f_createdMessage(int idx) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("CREATED", "CREATED", signalId) +
     "\n\n📌 LEBPRIME " + side + " LIMIT" +
     f_signalDetails(idx, "CREATED") +
     "\n\nAwaiting activation."

f_activatedMessage(int idx) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("ENTRY1", "ACTIVE", signalId) +
     "\n\n✅ LEBPRIME " + side + " — ENTRY 1 ACTIVATED" +
     f_signalDetails(idx, "ENTRY1")

f_entry2ActivatedMessage(int idx) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("ENTRY2", "ACTIVE", signalId) +
     "\n\n✅ LEBPRIME " + side + " — ENTRY 2 ACTIVATED" +
     f_signalDetails(idx, "ENTRY2")

f_tp1Message(int idx) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("TP1", "ACTIVE", signalId) +
     "\n\n🎯 LEBPRIME " + side + " — TP1 HIT" +
     f_signalDetails(idx, "TP1")

f_tp1FinalMessage(int idx, string reason) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("TP1", "COMPLETED", signalId) +
     "\n\n🎯 LEBPRIME " + side + " — TP1 FINAL" +
     f_signalDetails(idx, "TP1") +
     "\n\nFinal Result: TP1" +
     "\nReason: " + reason

f_tp2Message(int idx) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("TP2", "COMPLETED", signalId) +
     "\n\n🏆 LEBPRIME " + side + " — TP2 HIT" +
     f_signalDetails(idx, "TP2")

f_slMessage(int idx) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("SL", "COMPLETED", signalId) +
     "\n\n🛑 LEBPRIME " + side + " — SL HIT" +
     f_signalDetails(idx, "SL")

f_canceledMessage(int idx, string reason) =>
    bool demandSide = array.get(zDemand, idx)
    string side = f_sideTrade(demandSide)
    string signalId = array.get(zId, idx)

    f_eventHeader("CANCELED", "CANCELED", signalId) +
     "\n\n⚪ LEBPRIME " + side + " LIMIT — CANCELED" +
     f_signalDetails(idx, "CANCELED") +
     "\n\nReason: " + reason

f_jsonEscape(string value) =>
    string escaped = str.replace_all(value, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", "\\n")
    escaped := str.replace_all(escaped, "\t", "\\t")
    escaped

f_wrapAlert(string plainText) =>
    string outboundText = i_alertFormat == "Telegram webhook JSON" ?
         f_jsonEscape(plainText) : plainText

    i_alertFormat == "Telegram webhook JSON" ?
         "{\"chat_id\":\"" + f_jsonEscape(i_telegramChatId) +
         "\",\"text\":\"" + outboundText +
         "\",\"disable_web_page_preview\":true}" :
         outboundText

f_sendRaw(string plainText) =>
    bool deliveryReady = i_alertFormat != "Telegram webhook JSON" or
         str.length(i_telegramChatId) > 0

    if i_enableLifecycleAlerts and deliveryReady
        // All lifecycle transitions run on confirmed bars.
        // freq_all allows legitimate same-bar transitions such as
        // Entry 2 + TP1, or TP1 + TP2, to each emit their own alert.
        alert(f_wrapAlert(plainText), alert.freq_all)

f_sendCreated(int idx) =>
    f_sendRaw(f_createdMessage(idx))

f_sendActivated(int idx) =>
    f_sendRaw(f_activatedMessage(idx))

f_sendEntry2Activated(int idx) =>
    f_sendRaw(f_entry2ActivatedMessage(idx))

f_sendTp1(int idx) =>
    f_sendRaw(f_tp1Message(idx))

f_sendTp1Final(int idx, string reason) =>
    f_sendRaw(f_tp1FinalMessage(idx, reason))

f_sendTp2(int idx) =>
    f_sendRaw(f_tp2Message(idx))

f_sendSl(int idx) =>
    f_sendRaw(f_slMessage(idx))

f_sendCanceled(int idx, string reason) =>
    f_sendRaw(f_canceledMessage(idx, reason))

f_testMessage() =>
    string testId = "TEST-" + f_idSymbol() + "-" + f_tfCode() + "-" + f_signalDate() + "-LEB01"

    f_eventHeader("TEST", "TEST", testId) +
     "\n\n🧪 LEBPRIME WEBHOOK TEST" +
     "\n\nSymbol: " + f_displaySymbol() +
     "\nTimeframe: " + tfText +
     "\n\nTest only — no trading signal was created."

// ════════════════════════════════════════════════════════════════════════════
// SECTION 10: ZONE ARMING & CREATION
// ════════════════════════════════════════════════════════════════════════════

// VSS3-style clean 0.15% departure.
f_departureReady(bool demandSide, float top, float bot) =>
    float referenceEdge = demandSide ? top : bot
    float distancePercent = close != 0.0 ? math.abs(close - referenceEdge) / math.abs(close) * 100.0 : 0.0
    bool completelyOutside = demandSide ? (low > top and close > top) : (high < bot and close < bot)
    completelyOutside and distancePercent >= MIN_DEPARTURE_PERCENT

// LIMIT creation requires BOTH age and departure.
f_limitCreationReady(bool demandSide, float top, float bot, int sourceBar) =>
    bool oldEnoughForLimit = bar_index - sourceBar >= i_minBarsAfterSource
    oldEnoughForLimit and f_departureReady(demandSide, top, bot)

// VSS3-style invalidation used only before LIMIT CREATED.
// In "Close" mode, any candle-body breach invalidates the zone.
f_preLimitInvalidated(bool demandSide, float top, float bot) =>
    bool bodyBreak = demandSide ? math.min(open, close) < bot : math.max(open, close) > top
    bool wickBreak = demandSide ? low < bot : high > top
    i_invalidation == "Wick" ? wickBreak : bodyBreak


f_sellStopConfirmedByBodyClose(float stopLevel) =>
    float candleBodyTop = math.max(open, close)
    float candleBodyBottom = math.min(open, close)
    float candleBodySize = candleBodyTop - candleBodyBottom
    float candleBodyAboveStop = math.max(
         0.0,
         candleBodyTop - math.max(candleBodyBottom, stopLevel))
    close > stopLevel and candleBodySize > 0.0 and
         candleBodyAboveStop >= candleBodySize * 0.5

f_buyStopConfirmedByBodyClose(float stopLevel) =>
    float candleBodyTop = math.max(open, close)
    float candleBodyBottom = math.min(open, close)
    float candleBodySize = candleBodyTop - candleBodyBottom
    float candleBodyBelowStop = math.max(
         0.0,
         math.min(candleBodyTop, stopLevel) - candleBodyBottom)
    close < stopLevel and candleBodySize > 0.0 and
         candleBodyBelowStop >= candleBodySize * 0.5

f_stopConfirmed(bool demandSide, float stopLevel) =>
    demandSide ? f_buyStopConfirmedByBodyClose(stopLevel) :
         f_sellStopConfirmedByBodyClose(stopLevel)

// Mark zone as armed (ready for activation)
f_armZone(int idx) =>
    if idx >= 0 and idx < array.size(zArmed)
        if not array.get(zArmed, idx)
            f_setZoneTradeLevels(idx)
            array.set(zArmed, idx, true)
            array.set(zArmedBar, idx, bar_index)
            f_showTradeLevelLines(idx)
            f_updateZoneLabels(idx)
            f_sendCreated(idx)

// Create and register a new zone
f_createZone(bool demandSide, float top, float bot, int sourceBar, string candidateId, 
     bool startArmed) =>
    bool created = false
    bool liveCapacityAvailable = f_countSide(demandSide) < i_maxZones

    if top > bot and liveCapacityAvailable
        float zoneWidth = top - bot
        if f_isValidWidth(zoneWidth)
            color fill = demandSide ? i_demandColor : i_supplyColor
            color edge = demandSide ? color.new(#2962FF, 10) : color.new(#FB8C00, 10)

            box newBox = box.new(sourceBar, top, bar_index, bot, border_color = edge,
                 border_width = 1, bgcolor = fill)

            if i_showTF
                box.set_text(newBox, f_zoneText())
                box.set_text_color(newBox, color.new(color.white, 35))
                box.set_text_halign(newBox, text.align_right)
                box.set_text_valign(newBox, text.align_center)
                box.set_text_size(newBox, size.tiny)

            float zoneMid = (top + bot) / 2.0
            label infoLabel = label.new(bar_index + 1, zoneMid, "", style = label.style_none,
                 color = color.new(color.white, 100), textcolor = color.new(color.white, 100),
                 size = size.tiny)

            float entry = f_entry(demandSide, top, bot)
            float entry2 = f_entry2(demandSide, top, bot)
            float stop = f_structuralStop(demandSide, top, bot, sourceBar)
            float risk = math.abs(entry - stop)
            float tp1 = demandSide ? entry + risk * TP1_R : entry - risk * TP1_R
            float tp2 = demandSide ? entry + risk * TP2_R : entry - risk * TP2_R

            // x1 is assigned once while sourceBar is still near the current bar.
            // Later updates extend only x2, preventing long-lived-zone buffer errors.
            line tp1ZoneLine = line.new(sourceBar, tp1, bar_index, tp1,
                 color = color.new(#43A047, 100), width = 1)

            line tp2ZoneLine = line.new(sourceBar, tp2, bar_index, tp2,
                 color = color.new(#00C853, 100), width = 2)

            line slZoneLine = line.new(sourceBar, stop, bar_index, stop,
                 color = color.new(#E53935, 100), width = 1)

            array.push(zBox, newBox)
            array.push(zTag, infoLabel)
            array.push(zRetest, label(na))
            array.push(zEntry2Tag, label(na))
            array.push(zTp1Line, tp1ZoneLine)
            array.push(zTp2Line, tp2ZoneLine)
            array.push(zSlLine, slZoneLine)

            array.push(zTop, top)
            array.push(zBot, bot)
            array.push(zEntryPrice, entry)
            array.push(zEntry2Price, entry2)
            array.push(zStopPrice, stop)
            array.push(zTarget1Price, tp1)
            array.push(zTarget2Price, tp2)

            array.push(zDemand, demandSide)
            array.push(zBroken, false)
            array.push(zArmed, startArmed)
            array.push(zActivated, false)
            array.push(zEntry2Activated, false)
            array.push(zTp1Hit, false)
            array.push(zTp1HitBar, na)
            array.push(zTerminal, false)

            array.push(zSourceBar, sourceBar)
            array.push(zCreatedBar, bar_index)
            array.push(zArmedBar, startArmed ? bar_index : na)
            array.push(zLastRetestBar, na)
            array.push(zTouches, 0)
            array.push(zActivationBar, na)
            array.push(zEntry2ActivationBar, na)
            array.push(zId, candidateId)

            int newIndex = array.size(zBox) - 1
            if startArmed
                f_showTradeLevelLines(newIndex)
            f_updateZoneLabels(newIndex)
            created := true

    created

// Queue candidate invisibly.
// No box, label, TP or SL is drawn before LIMIT CREATED.
f_queueOrCreate(bool demandSide, float top, float bot, int sourceBar,
     string candidateId) =>
    bool accepted = false

    if top > bot
        array.push(pDemand, demandSide)
        array.push(pTop, top)
        array.push(pBot, bot)
        array.push(pSourceBar, sourceBar)
        array.push(pDueBar, bar_index + i_zoneConfirmDelay)
        array.push(pId, candidateId)
        accepted := true

    accepted

// Remove pending candidate at index
f_deletePendingAt(int idx) =>
    if idx >= 0 and idx < array.size(pDemand)
        array.remove(pDemand, idx)
        array.remove(pTop, idx)
        array.remove(pBot, idx)
        array.remove(pSourceBar, idx)
        array.remove(pDueBar, idx)
        array.remove(pId, idx)

// Process hidden candidates.
// A candidate becomes visible ONLY when all CREATE conditions are satisfied.
f_processPending() =>
    if array.size(pDemand) > 0 and barstate.isconfirmed
        int idx = array.size(pDemand) - 1

        while idx >= 0
            bool demandSide = array.get(pDemand, idx)
            float top = array.get(pTop, idx)
            float bot = array.get(pBot, idx)
            int sourceBar = array.get(pSourceBar, idx)
            int dueBar = array.get(pDueBar, idx)
            string candidateId = array.get(pId, idx)

            // VSS3-style body/wick invalidation while still hidden.
            bool invalidNow = f_preLimitInvalidated(demandSide, top, bot)

            if invalidNow
                // Failed hidden candidate: remove silently.
                f_deletePendingAt(idx)

            else
                bool confirmationComplete = bar_index >= dueBar
                bool limitReadyNow = confirmationComplete and
                     f_limitCreationReady(demandSide, top, bot, sourceBar)

                if limitReadyNow
                    // Recheck overlap at the actual creation moment because the
                    // candidate may have waited several bars while hidden.
                    bool noOverlapNow = not f_hasOverlap(demandSide, top, bot)

                    if noOverlapNow
                        // Create already ARMED: first visible state is BUY/SELL LIMIT CREATED.
                        bool created = f_createZone(
                             demandSide, top, bot, sourceBar, candidateId, true)

                        if created
                            int zoneIndex = f_findZoneIndex(candidateId)
                            if not na(zoneIndex)
                                // Final VSS3-style structural SL/TP at CREATED moment.
                                f_setZoneTradeLevels(zoneIndex)
                                f_showTradeLevelLines(zoneIndex)
                                f_updateZoneLabels(zoneIndex)
                                f_sendCreated(zoneIndex)

                            f_deletePendingAt(idx)
                    else
                        // A newer active same-side zone now overlaps this hidden candidate.
                        // Reject silently because no signal was ever created.
                        f_deletePendingAt(idx)

            idx -= 1

// ════════════════════════════════════════════════════════════════════════════
// SECTION 11: MOMENTUM DETECTION
// ════════════════════════════════════════════════════════════════════════════
// SECTION 11: MOMENTUM DETECTION & SIGNAL GENERATION
// ════════════════════════════════════════════════════════════════════════════

bool bullMomentum = close > open and math.abs(close - open) >= avgBody * i_bodyMult
bool bearMomentum = close < open and math.abs(close - open) >= avgBody * i_bodyMult

int bullCount = 0
int bearCount = 0
if bar_index >= i_momentumCount - 1
    for k = 0 to i_momentumCount - 1
        if close[k] > open[k] and math.abs(close[k] - open[k]) >= avgBody * i_bodyMult
            bullCount += 1
        if close[k] < open[k] and math.abs(close[k] - open[k]) >= avgBody * i_bodyMult
            bearCount += 1

bool inScanRange = bar_index > last_bar_index - i_historyBars
int historyRequired = i_momentumCount + i_compactSearchBars + 2
bool canDetect = bar_index >= historyRequired and not na(atr) and not na(avgBody)

bool bullQual = bullCount >= i_momentumCount
bool bearQual = bearCount >= i_momentumCount
bool bullEdge = bullQual and not bullQual[1]
bool bearEdge = bearQual and not bearQual[1]

var bool bullLeg = false
var bool bearLeg = false
bool demandReset = i_legResetMode == "Any opposite close" ? close < open : bearMomentum
bool supplyReset = i_legResetMode == "Any opposite close" ? close > open : bullMomentum

if demandReset
    bullLeg := false
if supplyReset
    bearLeg := false

bool newSignalDay = not na(time[1]) and time("D") != time("D")[1]
if newSignalDay
    dailySignalSequence := 0

bool fireBull = inScanRange and canDetect and bullEdge and not bullLeg and barstate.isconfirmed
bool fireBear = inScanRange and canDetect and bearEdge and not bearLeg and barstate.isconfirmed

// ────────────────────────────────────────────────────────────────────────────
// ZONE CREATION WITH NEW VALIDATIONS
// ────────────────────────────────────────────────────────────────────────────

if fireBull
    bool spacingOK = na(lastDemandCandidateBar) or
         bar_index - lastDemandCandidateBar >= i_minSameSideGap

    if spacingOK
        [rawTop, rawBot, anchorOffset] = f_boundary9Bounds(true)
        [top, bot] = f_clampZoneBounds(rawTop, rawBot)
        float zoneWidth = top - bot

        bool widthOK = f_isValidWidth(zoneWidth)
        bool noOverlap = not f_hasOverlap(true, top, bot)

        if widthOK and noOverlap
            string candidateId = f_makeZoneId(true, dailySignalSequence + 1)
            bool accepted = f_queueOrCreate(true, top, bot, bar_index - anchorOffset, candidateId)

            if accepted
                dailySignalSequence += 1
                lastDemandCandidateBar := bar_index

    bullLeg := true

if fireBear
    bool spacingOK = na(lastSupplyCandidateBar) or
         bar_index - lastSupplyCandidateBar >= i_minSameSideGap

    if spacingOK
        [rawTop, rawBot, anchorOffset] = f_boundary9Bounds(false)
        [top, bot] = f_clampZoneBounds(rawTop, rawBot)
        float zoneWidth = top - bot

        bool widthOK = f_isValidWidth(zoneWidth)
        bool noOverlap = not f_hasOverlap(false, top, bot)

        if widthOK and noOverlap
            string candidateId = f_makeZoneId(false, dailySignalSequence + 1)
            bool accepted = f_queueOrCreate(false, top, bot, bar_index - anchorOffset, candidateId)

            if accepted
                dailySignalSequence += 1
                lastSupplyCandidateBar := bar_index

    bearLeg := true

f_processPending()

// ════════════════════════════════════════════════════════════════════════════
// SECTION 12: VISIBLE ZONE LIFECYCLE MANAGEMENT
// ════════════════════════════════════════════════════════════════════════════
//
// TELEGRAM SIGNAL CONTRACT
//
//   HIDDEN CANDIDATE                -> nothing drawn, no Telegram alert
//       ↓  confirmation + minimum age + 0.15% clean departure
//   BUY/SELL LIMIT CREATED           -> FIRST visible state + CREATED alert exactly once
//       ↓
//       ├─ valid original-v2 retest  -> ACTIVATED alert exactly once
//       └─ invalid before activation -> CANCELED alert exactly once
//
//   ACTIVATED
//       ↓  activation candle: NO TP / NO SL
//       ↓  following candle+
//       ├─ target touched -> TP alert exactly once
//       └─ stop touched   -> SL alert exactly once
//
// Momentum, compact-base refinement, overlap, retest and post-CREATED lifecycle remain LebPrime-native.
// For an armed zone, a VALID retest has priority over same-bar invalidation.

if array.size(zBox) > 0
    int idx = array.size(zBox) - 1
    while idx >= 0
        bool removed = false

        if idx < array.size(zBox)
            box zoneBox = array.get(zBox, idx)
            float top = array.get(zTop, idx)
            float bot = array.get(zBot, idx)
            bool demandSide = array.get(zDemand, idx)
            bool broken = array.get(zBroken, idx)
            bool armed = array.get(zArmed, idx)
            bool activated = array.get(zActivated, idx)
            bool terminal = array.get(zTerminal, idx)
            int sourceBar = array.get(zSourceBar, idx)
            int armedBar = array.get(zArmedBar, idx)
            int lastTouch = array.get(zLastRetestBar, idx)
            int touchCount = array.get(zTouches, idx)

            bool tp1VisualDone = array.get(zTp1Hit, idx)

            if not terminal and not broken and not na(zoneBox) and not tp1VisualDone
                box.set_right(zoneBox, bar_index)
                if armed
                    f_updateZoneLabels(idx)
            bool closeBreak = demandSide ? close < bot : close > top
            bool wickBreak = demandSide ? low < bot : high > top
            bool invalidBeforeLimit = barstate.isconfirmed and f_preLimitInvalidated(demandSide, top, bot)
            bool invalidAfterCreated = barstate.isconfirmed and (i_invalidation == "Wick" ? wickBreak : closeBreak)

            // Before activation.
            if not terminal and not activated and not broken
                if not armed
                    // Visible only: no Telegram trade signal exists yet.
                    if invalidBeforeLimit
                        array.set(zTerminal, idx, true)
                        if i_showHistoric
                            array.set(zBroken, idx, true)
                            f_setHistoric(idx)
                        else
                            f_deleteAt(idx)
                            removed := true
                    else
                        bool limitReadyNow = barstate.isconfirmed and f_limitCreationReady(demandSide, top, bot, sourceBar)
                        if limitReadyNow
                            // f_armZone() sends CREATED once.
                            f_armZone(idx)
                else
                    // Original v2 retest conditions, unchanged.
                    bool oldEnough = bar_index - sourceBar >= i_minBarsAfterSource
                    bool afterArmingBar = na(armedBar) or bar_index > armedBar
                    bool overlaps = high >= bot and low <= top
                    bool approachedOutside = demandSide ? low[1] > top : high[1] < bot
                    bool cooldownOK = na(lastTouch) or bar_index - lastTouch > i_retestCooldown
                    bool firstTouchOnly = touchCount == 0
                    bool retestNow = barstate.isconfirmed and oldEnough and afterArmingBar and overlaps and cooldownOK and firstTouchOnly and approachedOutside

                    // Valid activation wins over same-bar invalidation.
                    if retestNow
                        array.set(zLastRetestBar, idx, bar_index)
                        array.set(zTouches, idx, touchCount + 1)

                        label oldActivation = array.get(zRetest, idx)
                        if not na(oldActivation)
                            label.delete(oldActivation)

                        float entry1 = array.get(zEntryPrice, idx)
                        float entry2 = array.get(zEntry2Price, idx)

                        label activationLabel = label.new(bar_index, entry1, "ENTRY 1 ACTIVATED",
                             style = demandSide ? label.style_label_up : label.style_label_down,
                             color = color.new(#FF9800, 0), textcolor = color.white, size = size.tiny)
                        array.set(zRetest, idx, activationLabel)

                        array.set(zActivated, idx, true)
                        array.set(zActivationBar, idx, bar_index)
                        array.set(zTp1Hit, idx, false)
                        array.set(zTp1HitBar, idx, na)
                        f_sendActivated(idx)

                        // Exactly like VSS3: Entry 2 can already be filled on
                        // the Entry 1 activation candle if price reaches the far edge.
                        bool entry2TouchedOnActivation = demandSide ? low <= entry2 : high >= entry2
                        if entry2TouchedOnActivation
                            label entry2Label = label.new(bar_index, entry2, "ENTRY 2 ACTIVATED",
                                 style = demandSide ? label.style_label_up : label.style_label_down,
                                 color = color.new(#7E57C2, 0), textcolor = color.white, size = size.tiny)
                            array.set(zEntry2Tag, idx, entry2Label)
                            array.set(zEntry2Activated, idx, true)
                            array.set(zEntry2ActivationBar, idx, bar_index)
                            f_sendEntry2Activated(idx)
                    else if invalidAfterCreated
                        // CREATED was already sent because this zone is armed.
                        // Original LebPrime close/wick cancellation behavior is preserved after CREATED.
                        f_sendCanceled(idx, "Zone invalidated before activation")
                        f_hideTradeLevelTags(idx)
                        array.set(zTerminal, idx, true)
                        if i_showHistoric
                            array.set(zBroken, idx, true)
                            f_setHistoric(idx)
                        else
                            f_deleteAt(idx)
                            removed := true

            // After activation: only TP or SL can finish the signal.
            // TP remains a price touch.
            // SL requires VSS3-style candle-close confirmation with at least
            // 50% of the candle body beyond the structural SL.
            // The activation candle is deliberately excluded from exit checks.
            if not removed and idx < array.size(zActivated)
                bool activeNow = array.get(zActivated, idx)
                bool terminalNow = array.get(zTerminal, idx)
                int activationBar = array.get(zActivationBar, idx)

                if activeNow and not terminalNow and barstate.isconfirmed and not na(activationBar) and bar_index > activationBar
                    bool tp1Done = array.get(zTp1Hit, idx)
                    bool entry2ActivatedNow = array.get(zEntry2Activated, idx)
                    float entry2 = array.get(zEntry2Price, idx)

                    // Entry 2 remains eligible only while TP1 has not been reached.
                    if not tp1Done and not entry2ActivatedNow
                        bool entry2TouchedNow = demandSide ? low <= entry2 : high >= entry2

                        if entry2TouchedNow
                            label oldEntry2Label = array.get(zEntry2Tag, idx)
                            if not na(oldEntry2Label)
                                label.delete(oldEntry2Label)

                            label entry2Label = label.new(
                                 bar_index, entry2, "ENTRY 2 ACTIVATED",
                                 style = demandSide ? label.style_label_up : label.style_label_down,
                                 color = color.new(#7E57C2, 0),
                                 textcolor = color.white,
                                 size = size.tiny)

                            array.set(zEntry2Tag, idx, entry2Label)
                            array.set(zEntry2Activated, idx, true)
                            array.set(zEntry2ActivationBar, idx, bar_index)
                            f_sendEntry2Activated(idx)

                    float entry1 = array.get(zEntryPrice, idx)
                    float stop = array.get(zStopPrice, idx)
                    float tp1 = array.get(zTarget1Price, idx)
                    float tp2 = array.get(zTarget2Price, idx)

                    bool tp1Touched = demandSide ? high >= tp1 : low <= tp1
                    bool tp2Touched = demandSide ? high >= tp2 : low <= tp2

                    if not tp1Done
                        // Before TP1: keep the approved v3.3.4 behavior.
                        // TP1 has priority over SL on the same confirmed candle.
                        if tp2Touched
                            array.set(zTp1Hit, idx, true)
                            array.set(zTp1HitBar, idx, bar_index)
                            f_sendTp1(idx)
                            f_markTp1Visual(idx)

                            f_sendTp2(idx)
                            f_hideTradeLevelTags(idx)
                            f_setTerminalStyle(idx, "TP2")
                            array.set(zTerminal, idx, true)

                        else if tp1Touched
                            array.set(zTp1Hit, idx, true)
                            array.set(zTp1HitBar, idx, bar_index)
                            f_sendTp1(idx)
                            f_markTp1Visual(idx)

                        else
                            bool stopConfirmed = f_stopConfirmed(demandSide, stop)
                            if stopConfirmed
                                f_sendSl(idx)
                                f_hideTradeLevelTags(idx)
                                f_setTerminalStyle(idx, "SL")
                                array.set(zTerminal, idx, true)

                    else
                        // TP1 was already achieved and remains the minimum final result.
                        // Start evaluating the final outcome only from the NEXT candle.
                        int tp1HitBar = array.get(zTp1HitBar, idx)
                        bool canFinalizeTp1 = not na(tp1HitBar) and bar_index > tp1HitBar

                        if canFinalizeTp1
                            bool returnedToEntry1 = demandSide ? low <= entry1 : high >= entry1
                            bool oldStopConfirmed = f_stopConfirmed(demandSide, stop)

                            // If the same candle reaches TP2 and also returns,
                            // TP2 wins because the final target was achieved.
                            if tp2Touched
                                f_sendTp2(idx)
                                f_hideTradeLevelTags(idx)
                                f_setTerminalStyle(idx, "TP2")
                                array.set(zTerminal, idx, true)

                            else if returnedToEntry1 or oldStopConfirmed
                                string finalReason = returnedToEntry1 ?
                                     "Price returned to Entry 1 after TP1" :
                                     "Price reached the previous Stop Loss condition after TP1"

                                f_sendTp1Final(idx, finalReason)
                                f_hideTradeLevelTags(idx)
                                f_setTerminalStyle(idx, "TP1")
                                array.set(zTerminal, idx, true)

        idx -= 1

// Apply terminal-history retention only after lifecycle iteration is complete.
f_trimHistoricToLimit(true)
f_trimHistoricToLimit(false)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 13: TP1 / TP2 / SL VISUALIZATION
// ════════════════════════════════════════════════════════════════════════════
//
// TP1, TP2 and SL are drawn per zone and use the same span as the zone box.
// After TP1, TP2 stays pending. If price later returns to Entry 1 or reaches\n// the old SL condition before TP2, the signal closes as TP1 — never as SL.
//
// ════════════════════════════════════════════════════════════════════════════
// SECTION 14: WEBHOOK TESTING & INTEGRATION
// ════════════════════════════════════════════════════════════════════════════

bool testDeliveryReady = i_alertFormat != "Telegram webhook JSON" or 
     str.length(i_telegramChatId) > 0

if i_enableLifecycleAlerts and i_autoWebhookTest and testDeliveryReady and 
     not autoWebhookTestSent and barstate.isrealtime and barstate.isconfirmed
    f_sendRaw(f_testMessage())
    autoWebhookTestSent := true

// ════════════════════════════════════════════════════════════════════════════
// END OF CODE
// ════════════════════════════════════════════════════════════════════════════
// TRADINGVIEW ALERT SETUP
//
// 1. Add "LebPrime Signals — FINAL Production v3.4.0" to the chart.
// 2. Create Alert.
// 3. Condition: this indicator -> Any alert() function call.
// 4. Enable webhook delivery if required by your LebPrime bridge.
// 5. Keep "Enable lifecycle alerts" ON only on the production chart.
//
// PROFESSIONAL LIFECYCLE EVENTS
// • BUY / SELL LIMIT CREATED
// • ENTRY 1 ACTIVATED
// • ENTRY 2 ACTIVATED
// • TP1 HIT -> ACTIVE for TP2; TP1 is now the minimum final result
// • TP2 HIT -> COMPLETED
// • SL HIT -> COMPLETED, only possible before TP1\n// • After TP1: return to Entry 1 / old SL condition -> TP1 COMPLETED
// • LIMIT CANCELED -> terminal before activation
// ════════════════════════════════════════════════════════════════════════════
