//@version=6
// ============================================================================
// LebPrime Signals — FINAL Production v3.4.0
//
// PURPOSE
//   Professional signal-generation indicator.
//   Hidden candidate -> LIMIT CREATED -> ENTRY 1 / ENTRY 2 -> TP1 / TP2 / SL.
//
// SIGNAL RULES
//   • Candidates stay completely hidden until LIMIT CREATED.
//   • Entry 1 = nearest zone edge.
//   • Entry 2 = far zone edge.
//   • Structural SL uses the first confirmed post-zone swing + instrument buffer.
//   • SL requires VSS3-style candle-close confirmation with >= 50% body beyond SL.
//   • TP1 is fixed at +1R from Entry 1.
//   • TP2 is fixed at +2R from Entry 1.
//   • Once TP1 is hit, SL tracking is permanently disabled for that signal.
//   • TP/SL checks start only from the candle AFTER Entry 1 activation.
//   • No break-even, partial-close, trailing-stop or position-management logic.
//   • Professional lifecycle alerts are emitted exactly once per state transition.
// ============================================================================

indicator("LebPrime Signals — FINAL Production v3.4.0", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500,
     max_bars_back = 2000)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 1: INPUT PARAMETERS (ORGANIZED BY FUNCTION)
// ════════════════════════════════════════════════════════════════════════════

// ── Boundary 9 Engine ───────────────────────────────────────────────────────
i_historyBars = input.int(500, "Recent history bars", minval = 100, maxval = 5000, 
     group = "Boundary 9 Engine",
     tooltip = "Limits zone detection to recent chart history. Use 500 for normal operation.")

i_bodyLen = input.int(20, "Average body length", minval = 5, maxval = 100, 
     group = "Boundary 9 Engine")

i_bodyMult = input.float(0.50, "Momentum body × average", minval = 0.10, maxval = 3.00, 
     step = 0.05, group = "Boundary 9 Engine",
     tooltip = "Higher = slower signals, more confirmation. Lower = faster but noisier.")

i_momentumCount = input.int(4, "Same-direction momentum candles", minval = 2, maxval = 10, 
     group = "Boundary 9 Engine",
     tooltip = "Minimum consecutive candles with directional impulse to trigger zone creation.")

i_atrLen = input.int(20, "ATR length", minval = 5, maxval = 100, 
     group = "Boundary 9 Engine",
     tooltip = "Used for zone width validation and SL/TP calculations.")

i_compactSearchBars = input.int(6, "Compact-base search bars", minval = 2, maxval = 30, 
     group = "Boundary 9 Engine",
     tooltip = "How far back to scan for the consolidation zone before momentum impulse.")

i_immediateBaseBars = input.int(2, "Fallback immediate-base bars", minval = 1, maxval = 6, 
     group = "Boundary 9 Engine",
     tooltip = "Fallback if proper compact base not found. Prevents missed signals.")

i_compressionBodyMult = input.float(0.60, "Compact body threshold × average", 
     minval = 0.05, maxval = 1.50, step = 0.05, group = "Boundary 9 Engine",
     tooltip = "Defines what counts as 'compressed' candle in the base.")

i_compactRangeAtr = input.float(0.90, "Compact range threshold × ATR", 
     minval = 0.10, maxval = 3.00, step = 0.05, group = "Boundary 9 Engine",
     tooltip = "Range must be tight relative to volatility.")

i_compactBaseMinBars = input.int(2, "Minimum compact-base candles", minval = 1, maxval = 8, 
