     tooltip = "Prevents zones on single candles.")

i_legResetMode = input.string("Opposite momentum", "Leg reset", 
     options = ["Opposite momentum", "Any opposite close"], group = "Boundary 9 Engine",
     tooltip = "How strictly to reset: only true opposite impulse vs. any close opposite.")

i_minSameSideGap = input.int(5, "Minimum bars between same-side candidates", minval = 5, maxval = 50, 
     group = "Boundary 9 Engine",
     tooltip = "Exact minimum spacing between consecutive same-side candidates. Default/minimum = 5 bars.")

i_zoneConfirmDelay = input.int(5, "Zone confirmation delay", minval = 0, maxval = 30, 
