indicator("LebPrime Signals final", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500,
     max_bars_back = 2000)

// ════════════════════════════════════════════════════════════════════════════
// SECTION 1: INPUT PARAMETERS (ORGANIZED BY FUNCTION)
