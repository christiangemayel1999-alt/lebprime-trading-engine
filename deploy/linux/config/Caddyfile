# /etc/caddy/Caddyfile - HTTPS front door for the dashboard (the only public web service).
# LEBPRIME_DOMAIN and LEBPRIME_DASH_BASIC come from /etc/default/caddy (root-only).
{
	admin off
}

{$LEBPRIME_DOMAIN} {
	log {
		output file /var/log/caddy/lebprime-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# Same-origin check: state-changing requests must come from this site's own pages (CSRF protection).
	@cross_origin_write {
		not method GET HEAD OPTIONS
		not header Origin https://{host}
	}
	respond @cross_origin_write "cross-origin request blocked" 403

	# /health is unauthenticated in the app and reveals the install path; keep it local.
	respond /health 404

	# Login gate: username + password + authenticator code (lebprime-auth.service).
	handle /auth/* {
		reverse_proxy 127.0.0.1:8601
	}

	handle {
		forward_auth 127.0.0.1:8601 {
			uri /auth/verify
		}
		# After the gate, Caddy supplies the app's own Basic credentials, so the app stays
		# protected even for anything that reaches 127.0.0.1:8501 directly.
		reverse_proxy 127.0.0.1:8501 {
			header_up Authorization "Basic {$LEBPRIME_DASH_BASIC}"
		}
	}
}
