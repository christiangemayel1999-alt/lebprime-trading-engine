# /etc/lebprime/lebprime.env  (root:lebprime 0640) - read by the bot, dashboard, worker and watchdog.
# Never commit the real file. Same variable names as the Windows .env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=OneRoyal-Demo
# The Windows terminal path means nothing on Linux; the gateway uses its own (gateway.env).
MT5_PATH=

# Mandatory in VPS mode: the dashboard refuses to start without them (16+ character password).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8501

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only ONE machine may poll Telegram. Keep this 0 on the VPS until the Windows bot and dashboard are stopped (handover).
TELEGRAM_REMOTE_CONTROL_ENABLED=0
TELEGRAM_MANUAL_TRADE_COMMANDS_ENABLED=0
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=

# Gateway client timeouts (seconds)
LEBPRIME_MT5_GATEWAY_HOST=127.0.0.1
LEBPRIME_MT5_GATEWAY_PORT=18812
LEBPRIME_MT5_GATEWAY_CALL_TIMEOUT=20
LEBPRIME_MT5_GATEWAY_EXEC_TIMEOUT=30
LEBPRIME_MT5_GATEWAY_RECONCILE_TIMEOUT=45
