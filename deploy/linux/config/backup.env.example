# /etc/lebprime/backup.env  (root:root 0600)
# Any restic backend works: Backblaze B2, S3, or SFTP to another machine. Example for B2:
RESTIC_REPOSITORY=b2:your-bucket-name:lebprime
RESTIC_PASSWORD_FILE=/etc/lebprime/restic.password
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# For S3: RESTIC_REPOSITORY=s3:s3.eu-west-2.amazonaws.com/your-bucket/lebprime + AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
