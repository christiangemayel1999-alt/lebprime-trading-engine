# /etc/lebprime/gateway.env  (root:lebprime-mt5 0640) - read by the MT5 terminal and gateway services.
# Windows paths are inside the Wine prefix; Z:\ is the Linux root.
LEBPRIME_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
LEBPRIME_WINE_PYTHON=C:\Python312\python.exe
LEBPRIME_MT5_GATEWAY_BIND=127.0.0.1
LEBPRIME_MT5_GATEWAY_PORT=18812
LEBPRIME_MT5_GATEWAY_KEY_FILE=Z:\etc\lebprime\gateway.key
LEBPRIME_GATEWAY_JOURNAL=Z:\var\lib\lebprime-mt5\gateway\executions.jsonl

# The only account this gateway will serve. A terminal logged into anything else blocks execution.
LEBPRIME_MT5_EXPECTED_LOGIN=
LEBPRIME_MT5_EXPECTED_SERVER=OneRoyal-Demo
# Optional: let the gateway log in by itself after a terminal restart (otherwise the bot's initialize() supplies them).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=OneRoyal-Demo

# Trading gate: disabled (read-only broker) -> reduce_only -> enabled. Change with `lebprime-ctl gate ...`.
LEBPRIME_GATEWAY_TRADING=disabled
# 1 = refuse to trade unless the terminal is on a demo account. Set 0 only after demo acceptance and a deliberate decision.
LEBPRIME_GATEWAY_DEMO_ONLY=1
LEBPRIME_GATEWAY_SYMBOLS=XAUUSD
# Hard per-order volume ceiling (lots), independent of the bot's risk settings.
LEBPRIME_GATEWAY_MAX_VOLUME=1.0
