#!/usr/bin/env python3
"""Refuse to start a VPS service with unsafe settings.

`lebprime-preflight dashboard` requires DASHBOARD_USERNAME and a strong
DASHBOARD_PASSWORD, so the dashboard can never come up unauthenticated.
"""

from __future__ import annotations

import os
import sys


def check_dashboard() -> list[str]:
    problems = []
    user = (os.environ.get("DASHBOARD_USERNAME") or "").strip()
    password = os.environ.get("DASHBOARD_PASSWORD") or ""
    if not user:
        problems.append("DASHBOARD_USERNAME is empty")
    if len(password) < 16:
        problems.append("DASHBOARD_PASSWORD must be at least 16 characters")
    if password.lower() in {"password", "changeme", "admin", user.lower()}:
        problems.append("DASHBOARD_PASSWORD is a default or equals the username")
    return problems


def main() -> int:
    target = sys.argv[1] if len(sys.argv) > 1 else ""
    problems = check_dashboard() if target == "dashboard" else [f"unknown preflight target {target!r}"]
    for problem in problems:
        print(f"lebprime-preflight: {problem} (set it in /etc/lebprime/lebprime.env)", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
