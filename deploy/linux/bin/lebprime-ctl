#!/usr/bin/env bash
# Operator helper for the LebPrime VPS (run with sudo).
#   lebprime-ctl status                 all services + gateway health
#   lebprime-ctl health                 gateway health as JSON
#   lebprime-ctl reconcile              broker positions/orders (this magic number) + execution journal problems
#   lebprime-ctl gate disabled|reduce_only|enabled   set the gateway trading gate and restart the gateway
#   lebprime-ctl logs [unit]            follow logs (default: bot + gateway)
#   lebprime-ctl restart-mt5            restart terminal (gateway follows)
set -euo pipefail
PY=/opt/lebprime/venv/bin/python
APP=/opt/lebprime/app
UNITS=(lebprime-xvfb lebprime-mt5-terminal lebprime-mt5-gateway lebprime-bot lebprime-dashboard lebprime-worker lebprime-watchdog.timer lebprime-backup.timer)

health_json() {
  LEBPRIME_MT5_GATEWAY_KEY_FILE=/etc/lebprime/gateway.key "$PY" - <<'PYEOF'
import json, sys
sys.path.insert(0, "/opt/lebprime/app")
from trading_bot.mt5_transport.client import GatewayMT5
client = GatewayMT5(call_timeout=10)
health = client.gateway_health()
print(json.dumps(health if health is not None else {"error": client.last_error()}, indent=2, default=str))
PYEOF
}

case "${1:-status}" in
  status)
    for unit in "${UNITS[@]}"; do printf '%-32s %s\n' "$unit" "$(systemctl is-active "$unit" || true)"; done
    echo; health_json
    ;;
  health) health_json ;;
  reconcile)
    LEBPRIME_MT5_GATEWAY_KEY_FILE=/etc/lebprime/gateway.key "$PY" - <<'PYEOF'
import json, sys
sys.path.insert(0, "/opt/lebprime/app")
from trading_bot.mt5_transport.client import GatewayMT5
cfg = json.load(open("/opt/lebprime/app/config.json"))
magic = cfg.get("mt5", {}).get("magic_number")
mt5 = GatewayMT5(call_timeout=15)
account = mt5.account_info()
print("account:", getattr(account, "login", None), getattr(account, "server", None), "balance", getattr(account, "balance", None), "equity", getattr(account, "equity", None))
for label, rows in (("positions", mt5.positions_get() or ()), ("pending orders", mt5.orders_get() or ())):
    print(f"\n{label}:")
    for row in rows:
        mark = "BOT" if getattr(row, "magic", None) == magic else "other"
        print(f"  [{mark}] ticket={row.ticket} {row.symbol} type={row.type} volume={getattr(row, 'volume', getattr(row, 'volume_current', None))} "
              f"price={getattr(row, 'price_open', None)} sl={row.sl} tp={row.tp} comment={row.comment!r}")
health = mt5.gateway_health() or {}
print("\ngateway execution journal:", health.get("executions"))
if (health.get("executions") or {}).get("ambiguous"):
    print("AMBIGUOUS requests exist: compare the positions above with the bot journal before resuming. See RUNBOOK.md.")
PYEOF
    ;;
  gate)
    mode="${2:?usage: lebprime-ctl gate disabled|reduce_only|enabled}"
    case "$mode" in disabled|reduce_only|enabled) ;; *) echo "invalid gate $mode" >&2; exit 2 ;; esac
    sed -i "s/^LEBPRIME_GATEWAY_TRADING=.*/LEBPRIME_GATEWAY_TRADING=$mode/" /etc/lebprime/gateway.env
    systemctl restart lebprime-mt5-gateway
    echo "gateway trading gate is now $mode"
    ;;
  logs)
    if [[ -n "${2:-}" ]]; then journalctl -fu "$2"; else journalctl -fu lebprime-bot -u lebprime-mt5-gateway; fi
    ;;
  restart-mt5) systemctl restart lebprime-mt5-terminal ;;
  *) sed -n '2,9p' "$0"; exit 2 ;;
esac
