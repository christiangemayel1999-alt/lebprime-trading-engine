#!/usr/bin/env bash
# Start the MT5 terminal inside the dedicated Wine prefix (run by lebprime-mt5-terminal.service).
set -euo pipefail
: "${WINEPREFIX:=/var/lib/lebprime-mt5/wine}"
: "${LEBPRIME_MT5_TERMINAL_PATH:=C:/Program Files/MetaTrader 5/terminal64.exe}"
unix_path="$(WINEPREFIX="$WINEPREFIX" winepath -u "$LEBPRIME_MT5_TERMINAL_PATH")"
if [[ ! -f "$unix_path" ]]; then
  echo "MT5 terminal not found at $LEBPRIME_MT5_TERMINAL_PATH ($unix_path)" >&2
  exit 1
fi
# /portable keeps the terminal's data next to the program inside the prefix.
exec wine "$LEBPRIME_MT5_TERMINAL_PATH" /portable
