[Unit]
Description=LebPrime dashboard login gate (password + TOTP), 127.0.0.1:8601
After=network.target
PartOf=lebprime.target

[Service]
User=lebprime-auth
Group=lebprime-auth
ExecStart=/usr/bin/python3 /opt/lebprime/deploy/auth/lebprime_auth.py serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/etc/lebprime/auth.json
MemoryMax=200M

[Install]
WantedBy=lebprime.target
